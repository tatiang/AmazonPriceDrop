{
  "manifest_version": 3,
  "name": "Amazon Price Drop Finder (≥10%)",
  "version": "1.10",
  "description": "Highlights Amazon cart and Saved for later items only when both percentage and minimum-dollar price-drop thresholds are met.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://amazon.com/*",
    "https://smile.amazon.com/*",
    "https://www.amazon.com/*"
  ],
  "action": {
    "default_title": "Find price drops",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*cart*",
        "https://www.amazon.com/gp/cart/*",
        "https://www.amazon.com/cart/*",
        "https://smile.amazon.com/*cart*",
        "https://smile.amazon.com/gp/cart/*",
        "https://smile.amazon.com/cart/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}